{
    "type": "APL",
    "version": "2023.2",
    "theme": "dark",
    "import": [
        {
            "name": "alexa-layouts",
            "version": "1.7.0"
        }
    ],
    "mainTemplate": {
        "parameters": ["payload"],
        "items": [
            {
                "type": "TouchWrapper",
                "width": "100%",
                "height": "100%",
                "onPress": [
                    {
                        "type": "SendEvent",
                        "arguments": ["OpenWidget"],
                        "flags": {
                            "interactionMode": "STANDARD"
                        }
                    }
                ],
                "item": {
                    "type": "Container",
                    "width": "100%",
                    "height": "100%",
                    "backgroundColor": "#1a1a2e",
                    "padding": 20,
                    "alignItems": "center",
                    "justifyContent": "center",
                    "items": [
                        {
                            "type": "Text",
                            "text": "Quick Stickies",
                            "fontSize": "28dp",
                            "color": "#FFF2AB",
                            "fontWeight": "bold",
                            "paddingBottom": "8dp"
                        },
                        {
                            "type": "Text",
                            "text": "Tap to open",
                            "fontSize": "18dp",
                            "color": "#888888"
                        }
                    ]
                }
            }
        ]
    }
}