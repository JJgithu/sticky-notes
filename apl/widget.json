{
    "type": "APL",
    "version": "2024.2",
    "theme": "dark",
    "extensions": [
        {
            "name": "DataStore",
            "uri": "alexaext:datastore:10"
        }
    ],
    "settings": {
        "DataStore": {
            "dataBindings": [
                {
                    "namespace": "quickStickies",
                    "key": "alertState",
                    "dataBindingName": "alertData",
                    "dataType": "object"
                }
            ]
        }
    },
    "import": [
        {
            "name": "alexa-layouts",
            "version": "1.7.0"
        }
    ],
    "mainTemplate": {
        "parameters": ["payload"],
        "items": [
            {
                "type": "TouchWrapper",
                "width": "100%",
                "height": "100%",
                "onPress": [
                    {
                        "type": "SendEvent",
                        "arguments": ["OpenWidget"],
                        "flags": {
                            "interactionMode": "STANDARD"
                        }
                    }
                ],
                "item": {
                    "type": "Container",
                    "width": "100%",
                    "height": "100%",
                    "backgroundColor": "#1a1a2e",
                    "paddingLeft": 16,
                    "paddingRight": 16,
                    "paddingTop": 12,
                    "paddingBottom": 12,
                    "justifyContent": "spaceBetween",
                    "items": [
                        {
                            "type": "Text",
                            "text": "${alertData.showBell == true ? '🔔' : ''}",
                            "fontSize": "100dp",
                            "color": "#ffffff",
                            "textAlign": "center",
                            "width": "100%"
                        },
                        {
                            "type": "Container",
                            "width": "100%",
                            "alignItems": "center",
                            "justifyContent": "center",
                            "grow": 1,
                            "items": [
                                {
                                    "type": "Text",
                                    "text": "Quick Stickies",
                                    "fontSize": "28dp",
                                    "color": "#FFF2AB",
                                    "fontWeight": "bold",
                                    "paddingBottom": "8dp"
                                },
                                {
                                    "type": "Text",
                                    "text": "Tap to open",
                                    "fontSize": "18dp",
                                    "color": "#888888"
                                }
                            ]
                        },
                        {
                            "type": "Text",
                            "text": "${alertData.showBell == true ? '🔔 ALERT ACTIVE' : ''}",
                            "fontSize": "12dp",
                            "color": "#ffffff",
                            "textAlign": "center",
                            "width": "100%"
                        }
                    ]
                }
            }
        ]
    }
}